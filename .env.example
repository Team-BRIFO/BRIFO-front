VITE_API_BASE_URL=https://api.example.com
VITE_KAKAO_CLIENT_ID=example_kakao_client_id
# Kakao JavaScript SDK / Kakao Talk Share. OAuth client ID와 다른 JavaScript 키를 사용합니다.
VITE_KAKAO_JAVASCRIPT_KEY=example_kakao_javascript_key
# Kakao Product Link에 등록한 공개 웹 주소. localhost:5173에서는 카카오톡 공유를 열 수 없습니다.
VITE_KAKAO_SHARE_WEB_URL=https://app.example.com
VITE_NAVER_CLIENT_ID=example_naver_client_id

# Optional override for Orval. Defaults to ${VITE_API_BASE_URL}/v3/api-docs
# ORVAL_OPENAPI_URL=https://api.example.com/v3/api-docs
