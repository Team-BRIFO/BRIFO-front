+        type="button"
+        size="lg"
+        color="primary"
+        isFullWidth
+        onClick={onNext}
+        className="mx-auto h-15 w-82 shadow-[0_4px_8px_rgba(168,79,1,0.15)]"
+      >
+        ?ㅼ쓬
+      </Button>
+    </div>
+  )
+}
