+        left={<StatusBarBackButton onClick={onBack} />}
+      />
+
+      <div className="mt-4">
+        <TextField
+          name="stockSearch"
+          variant="search"
+          value={searchKeyword}
+          placeholder="코스피 200 종목 검색"
+          onChange={(event) => onSearchKeywordChange(event.target.value)}
+          onClear={() => onSearchKeywordChange('')}
